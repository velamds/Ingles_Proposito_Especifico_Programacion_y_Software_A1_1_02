{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 0}, {"_data": [{"content": "establish ", "type": "text"}], "selected": 0, "id": 1, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "The IBM System/360 and OS/360 mainframe architectures ", "type": "text"}]}, {"type": "post_question", "contents": {"content": "the beginning of the modern computer industry.", "type": ""}}, {"content": "secondary_1", "type": "objective"}], "id": 0}, {"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 0}, {"_data": [{"content": "creates ", "type": "text"}], "selected": 0, "id": 1, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "In 1964 IBM ", "type": "text"}]}, {"type": "post_question", "contents": {"content": "the System/360.", "type": ""}}, {"content": "secondary_1", "type": "objective"}], "id": 1}, {"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 0}, {"_data": [{"content": "have", "type": "text"}], "selected": 0, "id": 1, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "The IBM System/360 and OS/360 ", "type": "text"}]}, {"type": "post_question", "contents": {"content": "a consistent architecture. ", "type": ""}}, {"content": "secondary_1", "type": "objective"}], "id": 2}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": " IBM: A Company of Great Computer Families", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 1", "type": "group_name"}]}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Move the words from the box to correctly complete the sentences.", "type": "text"}]}], "id": 12, "type": "SFL"}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"_data": [], "contents": [{}], "template_override": 1, "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "id": 1, "contents": [{"value": {"coverimg": "enpe7n1le02ob06re2img01.jpg", "images": [{"time": "0", "text": "<div align=\"justify\">FORTRAN (\u201cFORmula TRANslator\u201d), the world's first actual computer language was released in 1954 and, thanks to John Backus's vision, its IBM developer, it allowed people to program computers with simple instructions similar to the English language and with mathematical formulas.  FORTRAN's popularity led to the creation of COBOL (Common Business-Oriented Language) and together, they dominated programming until the end of the 70s. </br></br>\nAlthough these two early programming languages improved programming functions, there was not an actual operating system as we know it today.  Everyone agrees that MAD (Michigan Algorithmic Decoder), developed at the University of Michigan in 1959, is the first true operating system. However, the concept of the operating system wasn't very well known, until the influential development of IBM's S/360; The IBM System/360 and OS/360 mainframe architecture mark the beginning of the modern computer industry.</div>", "image": "enpe7n1le02ob06re2img01.jpg", "id": 0}, {"time": "81500", "text": "<div align=\"justify\">On April 1964, IBM launched the System/360, this model and the next versions of it, were the first successful family of computers ever. These 19 models had a consistent architecture in computers of different sizes. Their features were the use of the same peripherals and software. Therefore, it was easy to move onto new models as they were released. The idea was revolutionary because, before that, S/360 users had to rewrite their entire applications and replace the peripherals. </br></br>\nThe IBM System/360 mainframe architecture is a set of distinct terms and rules that are instructions to build products. In computer science, an architecture defines the structure of the computer system. Each generation of mainframe computers includes improvements in architecture to remain stable, secure, and compatible with as many computing platforms as possible.</div>", "image": "enpe7n1le02ob06re2img02.jpg", "id": 1}, {"time": "156000", "text": "<div align=\"justify\">Some people say that the S/360 IBM became the most successful computer in history thanks to its mainframe architecture. The importance of this architecture is that it presented a number of advances, such as the first transaction processing system and the first use of solid logic technology (SLT). However, these computers were not error-free and problems were not so easy to solve, the peripherals performed poorly, their processor was slow and their communication capabilities were virtually nonexistent. In spite of all of this, this mainframe architecture introduced the world's first sophisticated operating system. For the first time, compatibility was possible and a new part of the computers history began.  With the S/360 and OS/360, the operating system is now the key unique factor of a computer system.</div>", "image": "enpe7n1le02ob06re2img03.jpg", "id": 2}], "audiosrc": "enpe7n1le02ob06re2aud01"}, "type": "slideshow"}]}], "id": 0, "type": "scholar"}]}