"type": "text"}]}, {"selected": 0, "id": 1, "correct": 1, "_data": [{"content": "was too expensive", "type": "text"}]}, {"selected": 0, "id": 2, "correct": 0, "text": "", "_data": [{"content": "were too expensive", "type": "text"}]}, {"selected": 0, "id": 3, "correct": 0, "text": "", "_data": [{"content": "too expensive", "type": "text"}]}], "_data": [{"type": "question", "contents": [{"content": "The Analytical Engine ", "type": "text"}]}, {"type": "post_question", "contents": {"content": "and it wasn't finished. ", "type": ""}}, {"content": "secondary_1", "type": "objective"}]}], "_data": [{"type": "instructions", "contents": [{"content": "The Computer and Its Predecessors ", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "correct_feedback": "Correct!"}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Click on the drop-down list. Complete the sentence by selecting the correct answer.", "type": "text"}]}]}, {"id": 10, "type": "RSLT", "stimuli_ids": [], "template_override": 1, "questions": [{"id": 0, "responses": [{"selected": 0, "id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}]}, {"selected": 0, "id": 1, "correct": 1, "_data": [{"content": "", "type": "text"}]}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}]}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "correct_feedback": "Correct!"}, "type": "feedback"}]}, {"id": 11, "type": "DWS", "stimuli_ids": [], "template_override": 1, "questions": [{"id": 0, "responses": [{"selected": 0, "id": 0, "correct": 1, "_data": [{"content": "", "type": "text"}]}], "_data": [{"type": "question", "contents": [{"content": "enpe7n1le02ob02re7pdf01.pdf", "type": "pdf"}]}]}], "_data": [{"type": "instructions", "contents": [{"content": "Let's get more information on software history.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "correct_feedback": "You're done!"}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}]}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "", "type": "lesson_name"}, {"content": "Software before Computers", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 2, "type": "lesson"}, {"content": "A1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you hear and use to talk about software before computers.", "type": "text"}]}, {"type": "objectives", "contents": [{"content": "Identify information about the history of software and its characteristics in simple spoken and written situations.", "type": "primary"}, {"content": "Understands key information in simple written and spoken texts about topics related to software programming and its history.  Recognizes basic ideas on programming concepts and programming history in both written and spoken passages.", "type": "secondary_1"}]}, {"content": "enpe7n1le02ob02re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Simple Past Tense of Verb Be, Was in Affirmative Statements", "type": "heading"}, {"content": "You use the <strong>verb to be</strong> in past to talk about actions that already happened. ", "type": "describer"}, {"content": "The <strong>verb to be</strong> expresses the current state of people, objects or situations. When conjugated in the past, it describes events that are no longer happening. Events that started and finished in the past.</br></br>  The past of the <strong>verb to be</strong> changes depending on the pronoun. Take a look at the following chart:", "type": "text"}, {"content": "{\"rows\":7,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<strong>Pronoun</strong>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<strong>Verb to be</strong>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<center><strong>I</strong>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<center><strong>was</strong>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<center>You\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<center>were\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<center><strong>He / She / It</strong>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<center><strong>was</strong>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<center>We\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<center>were\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<center>They\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<center>were\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "To write affirmative statements with the <strong>verb to be in past</strong>, we can use the following grammatical structure:</br></br>  <div class=\"center_text\">Subject + <strong>was/were</strong> + complement</div></br></br>  Let's see a couple of examples:</br></br>  <i>The first computer <strong>was</strong> difficult to operate.</br> Charles Babbage <strong>was</strong> a very intelligent mathematician.</i>", "type": "text"}, {"content": "Most people know that the first computer was the ENIAC", "type": "example"}, {"content": "The concept of software was already old by then.", "type": "example"}, {"content": "One important character was Charles Babbage. ", "type": "example"}, {"content": "He was one of the great thinkers of the time and he was a mathematician with many ideas.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Verb Be with Too and Adjectives", "type": "heading"}, {"content": "You use the <span class =\"strong\"> verb to be</span> to talk about present or past statements. When you use <span class =\"strong\"> too + adjective</span>, you add an extra description to the statement.", "type": "describer"}, {"content": "In the previous learning point, we observed how the <span class =\"strong\">verb  to be</span> is conjugated in the past and how we use <span class =\"strong\"> was</span> and <span class =\"strong\">were</span> to talk about the past. Now, we are able to use the adverb <span class =\"strong\">too</span> plus an <span class =\"strong\">adjective</span> to say that the characteristic is excessive. ", "type": "text"}, {"content": "We can follow the next grammatical structure:", "type": "text"}, {"content": "<div class=\"center_text\">Subject + verb to be (in past or present) + <b>too</b> + <b>adjective</b> + complement </div>", "type": "text"}, {"content": "Let's see an example:", "type": "text"}, {"content": "<span class=\"italic\"> The first computer <span class =\"strong\">was too difficult </span>to operate.", "type": "text"}, {"content": "Notice how the adverb <strong>too</strong> provides an extra meaning to the sentence. In this case, we could say that not many people had the ability to operate the first computer because it was very difficult to do it.", "type": "text"}, {"content": "We can use <strong>too</strong> with any kind of <strong>adjective</strong>, let's see:</br></br><i>Understanding software is <strong>too hard</strong>. </i>", "type": "text"}, {"content": "The idea of a computer was too crazy at that time, wasn't it? ", "type": "example"}, {"content": "He was too privileged since he was able to invest a lot of time working with what could be, in theory, the first computer. ", "type": "example"}, {"content": "This device was too complex for some people.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "character ", "type": "name"}, {"content": "a relevant person in a story ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: One important character was Charles Babbage.", "type": "example"}, {"content": "enpe7n1le02ob02aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "mathematician ", "type": "name"}, {"content": "someone who works with mathematics", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He was one of the greatest thinkers of the time and he was a mathematician with many ideas.", "type": "example"}, {"content": "enpe7n1le02ob02aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "engineer  ", "type": "name"}, {"content": "a professional who works with numbers and equations in different fields of mechanics", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Unfortunately, it was too expensive for Babbage to complete his work and he had some problems working with his engineer.", "type": "example"}, {"content": "enpe7n1le02ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "expensive ", "type": "name"}, {"content": "something that is worth a lot of money", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Unfortunately, it was too expensive for Babbage to complete his work.", "type": "example"}, {"content": "enpe7n1le02ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "punched card ", "type": "name"}, {"content": "system that involved making holes on a card to get digital information", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He also worked on something famously called the Analytical Engine which included the use of punched cards.", "type": "example"}, {"content": "enpe7n1le02ob02aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "famously ", "type": "name"}, {"content": "being recognized because you did something remarkable", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: He also worked on something famously called the Analytical Engine which included the use of punched cards.", "type": "example"}, {"content": "enpe7n1le02ob02aud06", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "a)\tLook for further information about the early days of software.", "type": "text"}, {"content": "b)\tDesign a time line in which you include the most important events in software history. ", "type": "text"}, {"content": "c)\tPrepare a presentation to describe your time line.", "type": "text"}, {"content": "d)\tShare you work with your classmates and instructor. ", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "\u274f\tI look for information about the early days of software.", "type": "text"}, {"content": "\u274f\tI design a time line with all the information I found.", "type": "text"}, {"content": "\u274f\tI share my time line with my classmates and instructor. ", "type": "text"}]}]}